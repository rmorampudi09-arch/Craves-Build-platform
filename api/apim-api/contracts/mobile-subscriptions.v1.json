    {"id":"customerSubscriptions.getPlan","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"GET","path":"/api/v1/subscriptions/plans/{planId}","auth":"bearer","requestModel":"none","responseModel":"PublicSubscriptionPlan","requestValidator":"requireUuid(planId)","responseValidator":"publicSubscriptionPlanSchema"},
    {"id":"customerSubscriptions.getPlanSchedule","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"GET","path":"/api/v1/subscriptions/plans/{planId}/schedule","auth":"bearer","requestModel":"none","responseModel":"PublicPlanSchedule","requestValidator":"requireUuid(planId)","responseValidator":"publicPlanScheduleSchema"},
    {"id":"customerSubscriptions.listMine","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"GET","path":"/api/v1/subscriptions","auth":"bearer","requestModel":"none","responseModel":"CustomerSubscription[]","requestValidator":"authenticated customer","responseValidator":"customerSubscriptionSchema[]"},
    {"id":"customerSubscriptions.getMine","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"GET","path":"/api/v1/subscriptions/{subscriptionId}","auth":"bearer","requestModel":"none","responseModel":"CustomerSubscription","requestValidator":"requireUuid(subscriptionId)","responseValidator":"customerSubscriptionSchema"},
    {"id":"customerSubscriptions.listOccurrences","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"GET","path":"/api/v1/subscriptions/{subscriptionId}/occurrences","auth":"bearer","requestModel":"limit=100","responseModel":"CustomerSubscriptionOccurrence[]","requestValidator":"requireUuid(subscriptionId)","responseValidator":"customerSubscriptionOccurrenceSchema[]"},
    {"id":"customerSubscriptions.create","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"POST","path":"/api/v1/subscriptions","auth":"bearer","requestModel":"CreateCustomerSubscriptionRequest + Idempotency-Key","responseModel":"CustomerSubscription","requestValidator":"plan/address UUID + local-date + non-empty idempotency key","responseValidator":"customerSubscriptionSchema"},
    {"id":"customerSubscriptions.skip","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"POST","path":"/api/v1/subscriptions/{subscriptionId}/skips","auth":"bearer","requestModel":"{ serviceDate, reason? }","responseModel":"SkipRequestResponse","requestValidator":"subscription UUID + local date","responseValidator":"server acknowledgement"},
    {"id":"customerSubscriptions.pause","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"PATCH","path":"/api/v1/subscriptions/{subscriptionId}/pause","auth":"bearer","requestModel":"{ reason? }","responseModel":"CustomerSubscription","requestValidator":"requireUuid(subscriptionId)","responseValidator":"customerSubscriptionSchema"},
    {"id":"customerSubscriptions.resume","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"PATCH","path":"/api/v1/subscriptions/{subscriptionId}/resume","auth":"bearer","requestModel":"{ resumeDate, reason? }","responseModel":"CustomerSubscription","requestValidator":"subscription UUID + local date","responseValidator":"customerSubscriptionSchema"},
    {"id":"customerSubscriptions.cancel","source":"src/features/customerSubscription/api/customerSubscriptionApi.ts","method":"PATCH","path":"/api/v1/subscriptions/{subscriptionId}/cancel","auth":"bearer","requestModel":"{ reason? }","responseModel":"CustomerSubscription","requestValidator":"requireUuid(subscriptionId)","responseValidator":"customerSubscriptionSchema"},

    {"id":"chefSubscriptions.listPlans","source":"src/features/chefSubscription/api/chefSubscriptionApi.ts","method":"GET","path":"/api/v1/chef/subscription-plans","auth":"bearer","requestModel":"none","responseModel":"ChefMealPlan[]","requestValidator":"authenticated Chef","responseValidator":"chefMealPlanSchema[]"},
    {"id":"chefSubscriptions.getSchedule","source":"src/features/chefSubscription/api/chefSubscriptionApi.ts","method":"GET","path":"/api/v1/chef/subscription-plans/{planId}/schedule","auth":"bearer","requestModel":"none","responseModel":"ChefMealSchedule","requestValidator":"owned plan id","responseValidator":"chefMealScheduleSchema"},
    {"id":"chefSubscriptions.getCapacity","source":"src/features/chefSubscription/api/chefSubscriptionApi.ts","method":"GET","path":"/api/v1/chef/subscription-capacity","auth":"bearer","requestModel":"none","responseModel":"ChefCapacitySummary","requestValidator":"authenticated Chef","responseValidator":"chefCapacitySummarySchema"},
    {"id":"chefSubscriptions.createPlan","source":"src/features/chefSubscription/api/chefSubscriptionApi.ts","method":"POST","path":"/api/v1/chef/subscription-plans","auth":"bearer","requestModel":"ChefMealPlanInput","responseModel":"ChefMealPlan","requestValidator":"validated plan form","responseValidator":"chefMealPlanSchema"},
    {"id":"chefSubscriptions.submit","source":"src/features/chefSubscription/api/chefSubscriptionApi.ts","method":"POST","path":"/api/v1/chef/subscription-plans/{planId}/submit","auth":"bearer","requestModel":"{ note? }","responseModel":"ChefMealPlan","requestValidator":"owned editable plan","responseValidator":"chefMealPlanSchema"},
    {"id":"chefSubscriptions.updatePlan","source":"src/features/chefSubscription/api/chefSubscriptionApi.ts","method":"PUT","path":"/api/v1/chef/subscription-plans/{planId}","auth":"bearer","requestModel":"ChefMealPlanInput","responseModel":"ChefMealPlan","requestValidator":"owned editable plan + validated form","responseValidator":"chefMealPlanSchema"},
    {"id":"chefSubscriptions.putSchedule","source":"src/features/chefSubscription/api/chefSubscriptionApi.ts","method":"PUT","path":"/api/v1/chef/subscription-plans/{planId}/schedule","auth":"bearer","requestModel":"PutChefScheduleRequest","responseModel":"ChefMealSchedule","requestValidator":"active menu items + recurrence/day/time constraints","responseValidator":"chefMealScheduleSchema"},
    {"id":"chefSubscriptions.putSlotCapacity","source":"src/features/chefSubscription/api/chefSubscriptionApi.ts","method":"PUT","path":"/api/v1/chef/subscription-capacity/rules/slots","auth":"bearer","requestModel":"PutSlotRuleRequest","responseModel":"SlotRuleResponse","requestValidator":"weekday/slot/capacity integer constraints","responseValidator":"follow-up getCapacity reconciliation"}
