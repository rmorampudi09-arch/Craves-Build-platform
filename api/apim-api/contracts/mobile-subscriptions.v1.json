      "method": "GET",
      "path": "/api/v1/subscriptions/{subscriptionId}",
      "auth": "bearer",
      "requestModel": "none",
      "responseModel": "CustomerSubscription",
      "requestValidator": "requireUuid(subscriptionId)",
      "responseValidator": "customerSubscriptionSchema"
    },
    {
