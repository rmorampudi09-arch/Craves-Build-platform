      "auth": "bearer",
      "requestModel": "none",
      "responseModel": "PublicSubscriptionPlan[]",
      "requestValidator": "not-applicable",
      "responseValidator": "publicSubscriptionPlanSchema[]"
    },
    {
      "id": "customerSubscriptions.getPlan",
      "source": "src/features/customerSubscription/api/customerSubscriptionApi.ts",
      "method": "GET",
      "path": "/api/v1/subscriptions/plans/{planId}",
      "auth": "bearer",
      "requestModel": "none",
      "responseModel": "PublicSubscriptionPlan",
      "requestValidator": "requireUuid(planId)",
      "responseValidator": "publicSubscriptionPlanSchema"
    },
    {
      "id": "customerSubscriptions.getPlanSchedule",
