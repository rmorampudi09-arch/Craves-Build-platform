# Server-only API Management base. Include /api/v1 and do not expose this as NEXT_PUBLIC.
CRAVES_API_BASE_URL=https://apim-craves-prodlow-l3ing6.azure-api.net/api/v1

# Firebase Web application identifiers (never use Firebase Admin credentials here).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Cashfree hosted checkout. Keep sandbox until the controlled payment test succeeds.
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Development-only visual fallback when Catalog/APIM has no seeded data yet.
# Production must keep this false.
NEXT_PUBLIC_CRAVES_ALLOW_CATALOG_FALLBACK=false
