# Server-only API Management base. Include /api/v1 and do not expose this as NEXT_PUBLIC.
CRAVES_API_BASE_URL=https://api.craves.in/api/v1

# Server-only Ola Maps (Krutrim) key for search, reverse geocoding and the static map.
# SECRET: production binds it as a Key Vault-backed Container App secret reference
# (OLA_MAPS_API_KEY=secretref:ola-maps-api-key). Never use a NEXT_PUBLIC_ name for it.
OLA_MAPS_API_KEY=
# Optional "latitude,longitude" search bias used when the browser sends no location.
# A bias, not a restriction: other Indian cities still match.
CRAVES_LOCATION_SEARCH_CENTER=17.3850,78.4867

# Firebase Web application identifiers (never use Firebase Admin credentials here).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Razorpay hosted checkout. Keep sandbox until the controlled payment test succeeds.
NEXT_PUBLIC_RAZORPAY_MODE=sandbox

# Development-only visual fallback when Catalog/APIM has no seeded data yet.
# Production must keep this false.
NEXT_PUBLIC_CRAVES_ALLOW_CATALOG_FALLBACK=false

# Syncfusion EJ2 browser license. Store the real value in the deployment secret store;
# never commit it or paste it into application source.
NEXT_PUBLIC_SYNCFUSION_LICENSE_KEY=
