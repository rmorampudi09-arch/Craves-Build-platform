# Public runtime configuration only. Never commit secrets.
# Mobile API methods already include /api/v1, so this value must be the gateway origin only.
# For local or staging development, copy this file to an ignored .env and override both values.
CRAVES_ENVIRONMENT=production
CRAVES_API_BASE_URL=https://api.craves.in
# Rider app only: mock (demo data, no server) or live. Mock is used when this is missing.
CRAVES_RIDER_API_MODE=mock
