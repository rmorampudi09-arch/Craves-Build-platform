<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Rider-only permissions. Never add these to src/main: the customer app's Play declarations must not change. -->
    <!-- ACCESS_FINE_LOCATION and ACCESS_COARSE_LOCATION come from src/main. No ACCESS_BACKGROUND_LOCATION: the service starts from the Go Online tap. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Keeps the 10 s upload timer running with the screen off while online. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The trip-step outbox (P2-02): its job is persisted, so it runs after a reboot, and it waits for a network
         (Android 14+ requires ACCESS_NETWORK_STATE for that, and for the online service's network callback). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- A ringing offer opens over the lock screen (RiderOffers); Android 14+ also asks the rider (phone setup). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Phone setup's one-tap "Allow" for running in the background (RiderDeviceModule.openBatterySettings). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- riderLabel: "Craves Riders", or "Craves Riders Demo" for a demo build (build.gradle, cravesRiderDemo). -->
    <application android:label="${riderLabel}" tools:replace="android:label">
        <activity android:name=".MainActivity" android:label="${riderLabel}" tools:replace="android:label" />
        <service
            android:name=".RiderOnlineService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <service
            android:name=".RiderOutboxJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".RiderMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
