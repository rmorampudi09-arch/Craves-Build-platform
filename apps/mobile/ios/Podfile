# Expo modules (blur, glass, haptics, video…) link through Expo's autolinking, as on Android.
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Expo SDK 56 needs iOS 16.4.
platform :ios, '16.4'
prepare_react_native_project!

# Firebase comes from CocoaPods (not Swift Package Manager) and needs frameworks; static keeps launch fast.
$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'CravesMobile' do
  use_expo_modules!
  config = use_native_modules!(['npx', 'expo-modules-autolinking', 'react-native-config', '--json', '--platform', 'ios'])

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # MapLibre Native for @maplibre/maplibre-react-native comes from Swift Package Manager.
    $MLRN.post_install(installer)
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
