{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craves.in/contracts/events/order-ready-for-pickup-v1.schema.json",
  "title": "ORDER_READY_FOR_PICKUP v1.0",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "source",
    "subject",
    "data"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "ORDER_READY_FOR_PICKUP" },
    "eventVersion": { "const": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": ["string", "null"], "format": "uuid" },
    "source": { "const": "order-service" },
    "subject": { "type": "string", "minLength": 1 },
    "data": {
      "type": "object",
      "required": ["orderId", "chefSubOrderId", "readyAt"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "chefSubOrderId": { "type": "string", "format": "uuid" },
        "readyAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
