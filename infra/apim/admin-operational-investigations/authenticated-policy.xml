<policies>
  <inbound>
    <base />
    <set-variable name="cravesCorrelationId" value="@{
      var cravesCorrelationId = context.Request.Headers.GetValueOrDefault(&quot;X-Craves-Correlation-ID&quot;, &quot;&quot;);
      if (!System.String.IsNullOrWhiteSpace(cravesCorrelationId)) return cravesCorrelationId;
      var correlationId = context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-ID&quot;, &quot;&quot;);
      return !System.String.IsNullOrWhiteSpace(correlationId) ? correlationId : context.RequestId.ToString();
    }" />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables[&quot;cravesCorrelationId&quot;])</value>
    </set-header>
    <set-header name="X-Craves-Correlation-ID" exists-action="delete" />
    <choose>
      <when condition="@(!context.Request.Headers.ContainsKey(&quot;Authorization&quot;) || !context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;).StartsWith(&quot;Bearer &quot;, System.StringComparison.OrdinalIgnoreCase))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-body>{"error":"AUTHENTICATION_REQUIRED","message":"A Bearer access token is required."}</set-body>
        </return-response>
      </when>
    </choose>
    <set-backend-service base-url="__BACKEND_URL__" />
  </inbound>
  <backend><base /></backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables[&quot;cravesCorrelationId&quot;])</value>
    </set-header>
    <set-header name="X-Craves-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables[&quot;cravesCorrelationId&quot;])</value>
    </set-header>
    <set-header name="Cache-Control" exists-action="override"><value>no-store, no-cache, must-revalidate</value></set-header>
    <set-header name="Pragma" exists-action="override"><value>no-cache</value></set-header>
    <set-header name="X-Content-Type-Options" exists-action="override"><value>nosniff</value></set-header>
    <set-header name="X-Frame-Options" exists-action="override"><value>DENY</value></set-header>
  </outbound>
  <on-error><base /></on-error>
</policies>
