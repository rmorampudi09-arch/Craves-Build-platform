<policies>
  <inbound>
    <base />
    <!-- /locations and /devices only: the phone's online service sends the shift credential instead of a Bearer token.
         A 401 or 403 here ends the rider's shift on the phone, so either one is enough; the backend checks both. -->
    <choose>
      <when condition="@(!context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;).StartsWith(&quot;Bearer &quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; string.IsNullOrWhiteSpace(context.Request.Headers.GetValueOrDefault(&quot;X-Craves-Shift-Credential&quot;, &quot;&quot;)))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="Cache-Control" exists-action="override"><value>private, no-store</value></set-header>
          <set-body>{"code":"AUTHENTICATION_REQUIRED","message":"A Bearer access token or the shift credential is required."}</set-body>
        </return-response>
      </when>
    </choose>
    <!-- Up to 5 fixes, or one device registration: 16 KB is plenty. -->
    <validate-content unspecified-content-type-action="ignore" max-size="16384" size-exceeded-action="prevent" />
    <set-backend-service base-url="__BACKEND_URL__" />
  </inbound>
  <backend>
    <!-- One batch every 10-20 s never has more than one call in flight; 2 allows a retry to overlap a slow call. The key is the
         credential's first 12 characters (never the whole secret), else the token's subject. Over the limit is 429, which the
         phone retries on its next tick. The Consumption gateway has no keyed rate limit (docs/admin/explorer/README.md). -->
    <limit-concurrency key="@{
      var credential = context.Request.Headers.GetValueOrDefault(&quot;X-Craves-Shift-Credential&quot;, &quot;&quot;).Trim();
      if (credential.Length > 0) { return &quot;rider-shift-&quot; + credential.Substring(0, Math.Min(12, credential.Length)); }
      return &quot;rider-&quot; + (context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;).Split(' ').Last().AsJwt()?.Subject ?? context.Request.IpAddress);
    }" max-count="2">
      <forward-request timeout="20" />
    </limit-concurrency>
  </backend>
  <outbound>
    <base />
    <set-header name="Cache-Control" exists-action="override"><value>private, no-store</value></set-header>
    <set-header name="Pragma" exists-action="override"><value>no-cache</value></set-header>
    <set-header name="X-Content-Type-Options" exists-action="override"><value>nosniff</value></set-header>
  </outbound>
  <on-error><base /></on-error>
</policies>
