<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="600" renewal-period="60" counter-key="@(&quot;academy:&quot; + context.Request.IpAddress)" />
    <choose>
      <when condition="@(!context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;).StartsWith(&quot;Bearer &quot;))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Cache-Control" exists-action="override"><value>private, no-store</value></set-header>
          <set-body>{"code":"AUTHENTICATION_REQUIRED"}</set-body>
        </return-response>
      </when>
    </choose>
    <validate-content unspecified-content-type-action="ignore" max-size="16384" size-exceeded-action="prevent" />
    <!-- The existing Auth service verifies the signature, issuer, audience, live
         roles, account status, family revocation and original eight-hour deadline. -->
    <limit-concurrency key="academy-authority" max-count="8">
      <send-request mode="new" response-variable-name="academyAuthority" timeout="5" ignore-error="true">
        <set-url>__AUTH_ORIGIN__/api/v1/auth/me</set-url>
        <set-method>GET</set-method>
        <set-header name="Authorization" exists-action="override"><value>@(context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;))</value></set-header>
        <set-header name="Accept" exists-action="override"><value>application/json</value></set-header>
        <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
      </send-request>
    </limit-concurrency>
    <choose>
      <when condition="@{ var r = (IResponse)context.Variables[&quot;academyAuthority&quot;]; return r != null &amp;&amp; (r.StatusCode == 401 || r.StatusCode == 403); }">
        <return-response><set-status code="401" reason="Unauthorized" /><set-header name="Cache-Control" exists-action="override"><value>private, no-store</value></set-header><set-body>{"code":"SESSION_REQUIRED"}</set-body></return-response>
      </when>
      <when condition="@{ var r = (IResponse)context.Variables[&quot;academyAuthority&quot;]; return r == null || r.StatusCode != 200; }">
        <return-response><set-status code="503" reason="Service Unavailable" /><set-header name="Cache-Control" exists-action="override"><value>private, no-store</value></set-header><set-header name="Retry-After" exists-action="override"><value>5</value></set-header><set-body>{"code":"AUTHORITY_UNAVAILABLE"}</set-body></return-response>
      </when>
      <when condition="@(((IResponse)context.Variables[&quot;academyAuthority&quot;]).Headers.GetValueOrDefault(&quot;X-Craves-Admin-Session&quot;, &quot;&quot;) != &quot;verified-v1&quot;)">
        <return-response><set-status code="403" reason="Forbidden" /><set-header name="Cache-Control" exists-action="override"><value>private, no-store</value></set-header><set-body>{"code":"ADMIN_ACCESS_REQUIRED"}</set-body></return-response>
      </when>
    </choose>
    <set-backend-service base-url="__AUTH_ORIGIN__/api/v1/admin/academy" />
  </inbound>
  <backend><limit-concurrency key="academy-backend" max-count="8"><forward-request timeout="12" /></limit-concurrency></backend>
  <outbound>
    <base />
    <set-header name="Cache-Control" exists-action="override"><value>private, no-store</value></set-header>
    <set-header name="Vary" exists-action="override"><value>Authorization</value></set-header>
    <set-header name="X-Content-Type-Options" exists-action="override"><value>nosniff</value></set-header>
    <set-header name="X-Robots-Tag" exists-action="override"><value>noindex, nofollow</value></set-header>
  </outbound>
  <on-error>
    <base />
    <set-header name="Cache-Control" exists-action="override"><value>private, no-store</value></set-header>
    <set-header name="Retry-After" exists-action="override"><value>5</value></set-header>
  </on-error>
</policies>
